# Copy to .env and fill in. Never commit .env (it is in .gitignore, .dockerignore and .gcloudignore).

# --- Server ---
OAUTH_CLIENT_ID=yahoo-finance-mcp
# At least 32 characters. Generate with: openssl rand -hex 32
OAUTH_CLIENT_SECRET=

# Optional: public origin used as the OAuth issuer (derived from the request if unset)
# PUBLIC_BASE_URL=https://yahoo-finance-mcp-<project-number>.<region>.run.app
# Optional: extra allowed OAuth redirect URIs, comma-separated
# OAUTH_REDIRECT_URIS=
# Optional: JWT signing key (derived from the client secret if unset)
# OAUTH_SIGNING_KEY=
# PORT=8080

# --- Client-side values (fill in after deploying) ---
# MCP_URL=https://yahoo-finance-mcp-<project-number>.<region>.run.app/mcp
